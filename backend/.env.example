# ============ SERVER ============
NODE_ENV=development
PORT=5000

# ============ DATABASE ============
MONGODB_URI=mongodb://localhost:27017/crisis_engine

# ============ AUTH (use strong random values in production) ============
ACCESS_SECRET_KEY=change_me_access_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=12h

# ============ CLIENT URLS (CORS) ============
CITIZEN_CLIENT_URL=http://localhost:5173
DISPATCHER_CLIENT_URL=http://localhost:5174
PUBLIC_CITIZEN_URL=http://localhost:5173

# ============ DEFAULT ACCOUNTS (created on first boot — dev/test only) ============
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_OPERATOR_USERNAME=dispatcher
DEFAULT_OPERATOR_PASSWORD=Dispatcher123!
DEFAULT_BRIGADE_USERNAME=brigade1
DEFAULT_BRIGADE_PASSWORD=Brigade123!
DEFAULT_MANAGER_USERNAME=manager1
DEFAULT_MANAGER_PASSWORD=Manager123!

# ============ EXTERNAL ROUTING (OSRM-compatible, optional) ============
# Empty → the routing chain starts at the simulated road graph.
ROUTING_EXTERNAL_URL=
ROUTING_EXTERNAL_PROFILE=foot

# Operational thresholds (cluster, occupancy, triage, routing, rate limits)
# live in config/defaults/crisis.json and are editable at runtime
# from the admin panel (stored in MongoDB).

# ============ EDGE NODE (assembly-point local server, optional) ============
# Same backend in edge mode — see /edge/README.md. Leave EDGE_MODE unset on
# the central server.
# EDGE_MODE=true
# EDGE_NODE_ID=edge-sh06
# EDGE_SHELTER_CODE=SH-06
# CENTRAL_URL=https://api.safeflow.example
# EDGE_TOKEN=edge_...
# EDGE_PORTAL_URL=http://safeflow.local/
# EDGE_STATIC_DIR=../client-citizen/dist

# ---- AI providers (all optional — without them every AI feature runs on
# ---- deterministic mock data, clearly marked `mock: true`) ----------------
# Keys can also be entered in the dispatcher: İdarəetmə → AI provayderləri
# (stored AES-256-GCM encrypted in MongoDB; AI_SECRETS_KEY = encryption key)
# AI_SECRETS_KEY=change-me-long-random-string
# Google Gemini (LLM + vision). Model: admin config → ai.llm.geminiModel
# GEMINI_API_KEY=
# Claude (LLM parser, chatbot, vision fallback). Model/effort: admin config → ai.llm
# ANTHROPIC_API_KEY=
# Self-hosted AI gateway (local LLM): POST /v1/structured, POST /v1/chat
# AI_LOCAL_URL=http://localhost:8008
# Speech-to-text: Whisper API (key) or a local Whisper-compatible server (URL only)
# OPENAI_API_KEY=
# STT_API_KEY=
# STT_BASE_URL=http://localhost:9000/v1
# YOLOv8 damage model server: POST /predict (multipart "image") → { detections:[{label,confidence,box}] }
# VISION_YOLO_URL=http://localhost:8010
# MongoDB pool (burst latency)
# MONGO_MIN_POOL=20
# MONGO_MAX_POOL=100
