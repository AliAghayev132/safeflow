# ============ SERVER ============
NODE_ENV=development
PORT=5000

# ============ DATABASE ============
MONGODB_URI=mongodb://localhost:27017/crisis_engine

# ============ AUTH (use strong random values in production) ============
ACCESS_SECRET_KEY=change_me_access_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=12h

# ============ CLIENT URLS (CORS) ============
CITIZEN_CLIENT_URL=http://localhost:5173
DISPATCHER_CLIENT_URL=http://localhost:5174
PUBLIC_CITIZEN_URL=http://localhost:5173

# ============ DEFAULT ACCOUNTS (created on first boot — dev/test only) ============
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_OPERATOR_USERNAME=dispatcher
DEFAULT_OPERATOR_PASSWORD=Dispatcher123!
DEFAULT_BRIGADE_USERNAME=brigade1
DEFAULT_BRIGADE_PASSWORD=Brigade123!
DEFAULT_MANAGER_USERNAME=manager1
DEFAULT_MANAGER_PASSWORD=Manager123!

# ============ EXTERNAL ROUTING (OSRM-compatible, optional) ============
# Empty → the routing chain starts at the simulated road graph.
ROUTING_EXTERNAL_URL=
ROUTING_EXTERNAL_PROFILE=foot

# Operational thresholds (cluster, occupancy, triage, routing, rate limits)
# live in config/defaults/crisis.json and are editable at runtime
# from the admin panel (stored in MongoDB).
