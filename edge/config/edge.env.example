# /etc/safeflow/edge.env — SafeFlow edge node (assembly point)
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://localhost:27017/safeflow_edge

# Edge identity (create the node in the dispatcher → Resources → Edge nodes;
# the token is shown once)
EDGE_MODE=true
EDGE_NODE_ID=edge-sh06
EDGE_SHELTER_CODE=SH-06
CENTRAL_URL=https://api.safeflow.example
EDGE_TOKEN=edge_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Captive-portal landing URL (matches dnsmasq safeflow.local)
EDGE_PORTAL_URL=http://safeflow.local/

# Built citizen PWA (cd client-citizen && VITE_API_URL=same-origin npm run build)
EDGE_STATIC_DIR=/opt/safeflow/client-citizen/dist

# Local staff accounts (the node has its own database)
ACCESS_SECRET_KEY=change_me_long_random_secret_for_this_node
DEFAULT_ADMIN_PASSWORD=change_me
DEFAULT_OPERATOR_PASSWORD=change_me
DEFAULT_BRIGADE_PASSWORD=change_me
